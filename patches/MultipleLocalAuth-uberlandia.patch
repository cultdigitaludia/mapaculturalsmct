+    function validateCNPJ($cnpj) {
+        $cnpj = strtoupper(preg_replace('/[^A-Z0-9]/i', '', (string) $cnpj));
+
+        if (!preg_match('/^[A-Z0-9]{12}[0-9]{2}$/', $cnpj) || preg_match('/^(.)\1{13}$/', $cnpj)) {
+            return false;
+        }
+
+        $weights = [
+            [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2],
+            [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2],
+        ];
+
+        foreach ($weights as $index => $digitWeights) {
+            $sum = 0;
+            foreach ($digitWeights as $position => $weight) {
+                $sum += (ord($cnpj[$position]) - 48) * $weight;
+            }
+
+            $remainder = $sum % 11;
+            $digit = $remainder < 2 ? 0 : 11 - $remainder;
+            if ((int) $cnpj[12 + $index] !== $digit) {
+                return false;
+            }
+        }
+
+        return true;
+    }
